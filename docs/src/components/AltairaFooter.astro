---
/**
 * AltairaLabs Common Footer Component
 *
 * A minimal, non-intrusive footer for documentation sites that enables
 * easy navigation between AltairaLabs products.
 *
 * Built to the Atlas design handoff: a hairline top rule over the page
 * canvas (no fill of its own), the gold Star Tile glyph beside an uppercase
 * mono wordmark, plain product links, and a mono copyright pushed right.
 * Every colour, face and metric comes from an Atlas token — the previous
 * version hardcoded a slate palette and Inter, which was the last piece of
 * chrome sitting outside the design system.
 *
 * Usage:
 *   import AltairaFooter from './components/AltairaFooter.astro';
 *   <AltairaFooter current="omnia" />
 *
 * Props:
 *   current: 'omnia' | 'promptkit' | 'promptarena' | 'promptpack' - highlights the active product
 */

interface Props {
  current?: 'omnia' | 'promptkit' | 'promptarena' | 'promptpack';
}

const { current } = Astro.props;

// Order follows the design handoff's footer lockup.
const products = [
  { id: 'promptpack', name: 'PromptPack', url: 'https://promptpack.org' },
  { id: 'promptkit', name: 'PromptKit', url: 'https://promptkit.altairalabs.ai' },
  { id: 'promptarena', name: 'PromptArena', url: 'https://promptkit.altairalabs.ai/arena/' },
  { id: 'omnia', name: 'Omnia', url: 'https://omnia.altairalabs.ai' },
];

const year = new Date().getFullYear();
---

<footer class="altaira-footer">
  <div class="altaira-footer-inner">
    <a href="https://altairalabs.ai" class="altaira-footer-brand" title="AltairaLabs">
      <img src="/star-glyph-gold.svg" width="13" height="13" alt="" aria-hidden="true" />
      Altaira Labs
    </a>

    <nav class="altaira-footer-nav" aria-label="AltairaLabs Products">
      {
        products.map((product) => (
          <a
            href={product.url}
            class:list={['altaira-footer-link', { active: current === product.id }]}
            aria-current={current === product.id ? 'page' : undefined}
          >
            {product.name}
          </a>
        ))
      }
    </nav>

    <span class="altaira-footer-copyright">© {year} AltairaLabs</span>
  </div>
</footer>

<style>
  .altaira-footer {
    border-top: 1px solid var(--hairline);
    padding: 36px 48px 56px;
    /* Starlight's sidebar is position:fixed, and this footer is a body-level
       sibling outside the layout grid — without the same inline-start offset
       .main-frame uses, the sidebar sits on top of the brand lockup. The
       token is 0 below the sidebar breakpoint, so no media query is needed. */
    padding-inline-start: calc(var(--sl-content-inline-start, 0px) + 48px);
  }

  .altaira-footer-inner {
    max-width: 1080px;
    margin: 0 auto;
    display: flex;
    align-items: center;
    gap: 28px;
    flex-wrap: wrap;
  }

  .altaira-footer-brand {
    display: flex;
    align-items: center;
    gap: 9px;
    font: 500 11px/1 var(--font-mono);
    letter-spacing: var(--tracking-wide);
    text-transform: uppercase;
    color: var(--text-muted);
    text-decoration: none;
    border-bottom: 0;
    flex-shrink: 0;
    transition: color var(--dur-base, 200ms) var(--ease-standard, ease);
  }

  .altaira-footer-brand:hover {
    color: var(--text-heading);
  }

  .altaira-footer-nav {
    display: flex;
    gap: 20px;
    flex-wrap: wrap;
    font: 400 13px/1 var(--font-sans);
  }

  .altaira-footer-link {
    color: var(--text-muted);
    text-decoration: none;
    border-bottom: 1px solid transparent;
    transition: color var(--dur-base, 200ms) var(--ease-standard, ease);
  }

  .altaira-footer-link:hover {
    color: var(--text-heading);
    border-bottom-color: var(--accent-inter);
  }

  .altaira-footer-link.active {
    color: var(--text-heading);
  }

  .altaira-footer-copyright {
    margin-left: auto;
    font: 400 12px/1 var(--font-mono);
    color: var(--text-faint);
  }

  @media (max-width: 30rem) {
    .altaira-footer-copyright {
      margin-left: 0;
    }
  }
</style>
