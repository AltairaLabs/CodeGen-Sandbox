---
/**
 * AltairaLabs Common Footer Component
 *
 * A minimal, non-intrusive footer for documentation sites that enables
 * easy navigation between AltairaLabs products.
 *
 * Usage:
 *   import AltairaFooter from './components/AltairaFooter.astro';
 *   <AltairaFooter current="omnia" />
 *
 * Props:
 *   current: 'omnia' | 'promptkit' | 'promptarena' | 'promptpack' - highlights the active product
 */

interface Props {
  current?: 'omnia' | 'promptkit' | 'promptarena' | 'promptpack';
}

const { current } = Astro.props;

const products = [
  {
    id: 'promptarena',
    name: 'PromptArena',
    description: 'Testing',
    url: 'https://promptkit.altairalabs.ai/arena/',
    color: '#8B5CF6',
  },
  {
    id: 'promptpack',
    name: 'PromptPack',
    description: 'Packaging',
    url: 'https://promptpack.org',
    color: '#7045AF',
  },
  {
    id: 'promptkit',
    name: 'PromptKit',
    description: 'Runtime',
    url: 'https://promptkit.altairalabs.ai',
    color: '#6366F1',
  },
  {
    id: 'omnia',
    name: 'Omnia',
    description: 'Platform',
    url: 'https://omnia.altairalabs.ai',
    color: '#3B82F6',
  },
];
---

<footer class="altaira-footer">
  <div class="altaira-footer-inner">
    <!-- AltairaLabs Logo -->
    <a href="https://altairalabs.ai" class="altaira-footer-brand" title="AltairaLabs">
      <svg viewBox="0 0 200 40" fill="none" class="altaira-logo">
        <g id="mark">
          <circle cx="20" cy="20" r="3" fill="#3B82F6"/>
          <circle cx="20" cy="6" r="2.5" fill="#3B82F6"/>
          <circle cx="8" cy="18" r="2" fill="#06B6D4"/>
          <circle cx="32" cy="18" r="2" fill="#06B6D4"/>
          <circle cx="12" cy="32" r="1.5" fill="#8B5CF6"/>
          <circle cx="28" cy="32" r="1.5" fill="#8B5CF6"/>
          <line x1="20" y1="8.5" x2="20" y2="17" stroke="#3B82F6" stroke-width="1.5" stroke-linecap="round"/>
          <line x1="10" y1="18" x2="17" y2="20" stroke="#06B6D4" stroke-width="1.5" stroke-linecap="round"/>
          <line x1="30" y1="18" x2="23" y2="20" stroke="#06B6D4" stroke-width="1.5" stroke-linecap="round"/>
          <line x1="13" y1="31" x2="18" y2="22" stroke="#8B5CF6" stroke-width="1.5" stroke-linecap="round"/>
          <line x1="27" y1="31" x2="22" y2="22" stroke="#8B5CF6" stroke-width="1.5" stroke-linecap="round"/>
        </g>
        <text x="48" y="26" font-family="Inter, -apple-system, sans-serif" font-size="18" font-weight="700" letter-spacing="0.05em" fill="currentColor">ALTAIRA</text>
        <text x="138" y="26" font-family="Inter, -apple-system, sans-serif" font-size="18" font-weight="400" letter-spacing="0.15em" fill="#64748B">LABS</text>
      </svg>
    </a>

    <!-- Divider -->
    <span class="altaira-footer-divider"></span>

    <!-- Product Navigation -->
    <nav class="altaira-footer-nav" aria-label="AltairaLabs Products">
      {products.map((product) => (
        <a
          href={product.url}
          class:list={['altaira-footer-link', { active: current === product.id }]}
          style={`--product-color: ${product.color}`}
          aria-current={current === product.id ? 'page' : undefined}
        >
          <span class="altaira-footer-link-icon">
            {product.id === 'omnia' && (
              <svg viewBox="0 0 32 32" fill="none">
                <polygon points="16,4 26,10 26,22 16,28 6,22 6,10" stroke="currentColor" stroke-width="2" fill="none"/>
                <circle cx="16" cy="16" r="3" fill="currentColor"/>
              </svg>
            )}
            {product.id === 'promptkit' && (
              <svg viewBox="0 0 128 128" fill="none">
                <path d="M24 32 L48 64 L24 96" stroke="currentColor" stroke-width="12" stroke-linecap="round" stroke-linejoin="round" fill="none"/>
                <rect x="60" y="28" width="44" height="20" rx="4" fill="currentColor"/>
                <rect x="60" y="54" width="44" height="20" rx="4" fill="currentColor" opacity="0.7"/>
                <rect x="60" y="80" width="44" height="20" rx="4" fill="currentColor" opacity="0.5"/>
              </svg>
            )}
            {product.id === 'promptarena' && (
              <svg viewBox="0 0 128 128" fill="none">
                <circle cx="64" cy="64" r="44" stroke="currentColor" stroke-width="6" fill="none"/>
                <circle cx="64" cy="64" r="28" stroke="currentColor" stroke-width="4" fill="none" opacity="0.7"/>
                <circle cx="64" cy="64" r="12" stroke="currentColor" stroke-width="3" fill="none" opacity="0.5"/>
                <circle cx="64" cy="64" r="4" fill="currentColor"/>
              </svg>
            )}
            {product.id === 'promptpack' && (
              <svg viewBox="0 0 100 100" fill="none">
                <path d="M50,10 L80,27 L80,73 L50,90 L20,73 L20,27 Z" stroke="currentColor" stroke-width="4" fill="none"/>
                <circle cx="50" cy="50" r="12" fill="currentColor"/>
                <circle cx="50" cy="27" r="4" fill="currentColor"/>
                <circle cx="50" cy="73" r="4" fill="currentColor"/>
                <circle cx="27" cy="38" r="4" fill="currentColor" opacity="0.7"/>
                <circle cx="73" cy="38" r="4" fill="currentColor" opacity="0.7"/>
                <circle cx="27" cy="62" r="4" fill="currentColor" opacity="0.7"/>
                <circle cx="73" cy="62" r="4" fill="currentColor" opacity="0.7"/>
              </svg>
            )}
          </span>
          <span class="altaira-footer-link-text">
            <span class="altaira-footer-link-name">{product.name}</span>
            <span class="altaira-footer-link-desc">{product.description}</span>
          </span>
        </a>
      ))}
    </nav>

    <!-- Copyright (visible on larger screens) -->
    <span class="altaira-footer-copyright">
      © {new Date().getFullYear()} AltairaLabs
    </span>
  </div>
</footer>

<style>
  .altaira-footer {
    --footer-bg: #0F172A;
    --footer-border: #1E293B;
    --footer-text: #94A3B8;
    --footer-text-hover: #F8FAFC;

    position: relative;
    width: 100%;
    background: var(--footer-bg);
    border-top: 1px solid var(--footer-border);
    font-family: Inter, -apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, sans-serif;
  }

  .altaira-footer-inner {
    display: flex;
    align-items: center;
    gap: 1rem;
    max-width: 1400px;
    margin: 0 auto;
    padding: 0.75rem 1.5rem;
  }

  .altaira-footer-brand {
    display: flex;
    align-items: center;
    text-decoration: none;
    color: var(--footer-text);
    transition: color 0.15s ease;
    flex-shrink: 0;
  }

  .altaira-footer-brand:hover {
    color: var(--footer-text-hover);
  }

  .altaira-logo {
    height: 24px;
    width: auto;
  }

  .altaira-footer-divider {
    width: 1px;
    height: 24px;
    background: var(--footer-border);
    flex-shrink: 0;
  }

  .altaira-footer-nav {
    display: flex;
    align-items: center;
    gap: 0.25rem;
    flex: 1;
    overflow-x: auto;
    scrollbar-width: none;
    -ms-overflow-style: none;
  }

  .altaira-footer-nav::-webkit-scrollbar {
    display: none;
  }

  .altaira-footer-link {
    display: flex;
    align-items: center;
    gap: 0.5rem;
    padding: 0.375rem 0.75rem;
    border-radius: 6px;
    text-decoration: none;
    color: var(--footer-text);
    transition: all 0.15s ease;
    white-space: nowrap;
    flex-shrink: 0;
  }

  .altaira-footer-link:hover {
    color: var(--product-color);
    background: rgba(255, 255, 255, 0.05);
  }

  .altaira-footer-link.active {
    color: var(--product-color);
    background: rgba(255, 255, 255, 0.08);
  }

  .altaira-footer-link-icon {
    width: 18px;
    height: 18px;
    flex-shrink: 0;
  }

  .altaira-footer-link-icon svg {
    width: 100%;
    height: 100%;
  }

  .altaira-footer-link-text {
    display: flex;
    flex-direction: column;
    line-height: 1.2;
  }

  .altaira-footer-link-name {
    font-size: 0.8125rem;
    font-weight: 500;
  }

  .altaira-footer-link-desc {
    font-size: 0.6875rem;
    opacity: 0.7;
  }

  .altaira-footer-copyright {
    font-size: 0.75rem;
    color: var(--footer-text);
    opacity: 0.6;
    flex-shrink: 0;
    white-space: nowrap;
  }

  /* Mobile: Stack layout */
  @media (max-width: 640px) {
    .altaira-footer-inner {
      flex-wrap: wrap;
      justify-content: center;
      gap: 0.75rem;
      padding: 1rem;
    }

    .altaira-footer-divider {
      display: none;
    }

    .altaira-footer-nav {
      order: 2;
      width: 100%;
      justify-content: center;
    }

    .altaira-footer-link-desc {
      display: none;
    }

    .altaira-footer-copyright {
      order: 3;
      width: 100%;
      text-align: center;
    }
  }

  /* Dark mode support (inherits from parent theme if available) */
  :root[data-theme="light"] .altaira-footer,
  .altaira-footer[data-theme="light"] {
    --footer-bg: #F8FAFC;
    --footer-border: #E2E8F0;
    --footer-text: #64748B;
    --footer-text-hover: #0F172A;
  }
</style>
